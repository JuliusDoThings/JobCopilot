      "expected": [
        {
          "skill": "SQL",
          "status": "needs_clarification",
          "evidence": "Compétences : SQL",
          "suggestion": null,
          "questionRequired": true
        }
      ]
    },
    {
      "id": "VAL-007",
      "title": "Expérience en langage naturel",
