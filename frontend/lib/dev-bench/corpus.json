{
  "version": "S4-VAL-001-v1",
  "scenarios": [
    {
      "id": "VAL-001",
      "title": "Activité explicitement démontrée",
      "rationale": "Une activité explicite peut être mise en avant, sans réécriture inventive.",
      "input": {
        "cv_text": "Développement d’API avec Python.",
        "target_skills": [
          "Python"
        ]
      },
      "expected": [
        {
          "skill": "Python",
          "status": "suggested",
          "evidence": "Développement d’API avec Python.",
          "suggestion": "Développement d’API avec Python.",
          "questionRequired": false
        }
      ]
    },
    {
      "id": "VAL-002",
      "title": "Compétence seulement listée",
      "rationale": "Un intitulé seul ne prouve pas un usage. Demander le contexte et le rôle.",
      "input": {
        "cv_text": "Compétences : SQL",
        "target_skills": [
          "SQL"
        ]
      },
      "expected": [
        {
          "skill": "SQL",
          "status": "needs_clarification",
          "evidence": "Compétences : SQL",
          "suggestion": null,
          "questionRequired": true
        }
      ]
    },
    {
      "id": "VAL-003",
      "title": "Compétence absente",
      "rationale": "Une compétence ciblée absente du CV ne doit jamais être ajoutée.",
      "input": {
        "cv_text": "Support aux utilisateurs.",
        "target_skills": [
          "Docker"
        ]
      },
      "expected": [
        {
          "skill": "Docker",
          "status": "no_evidence",
          "evidence": null,
          "suggestion": null,
          "questionRequired": false
        }
      ]
    },
    {
      "id": "VAL-004",
      "title": "Rôle ambigu",
      "rationale": "Participer à un projet ne démontre pas quelle action a été réalisée.",
