        "cv_text": "Participation à un projet Python.",
        "target_skills": [
          "Python"
        ]
      },
      "expected": [
        {
          "skill": "Python",
          "status": "needs_clarification",
          "evidence": "Participation à un projet Python.",
          "suggestion": null,
          "questionRequired": true
        }
      ]
    },
    {
      "id": "VAL-005",
      "title": "Négation explicite",
      "rationale": "Une négation ne constitue pas une expérience positive.",
